# ==============================================================================
# HERO PAGE - MULTI-PAGE MESSENGER SAAS ENVIRONMENT CONFIGURATION
# ==============================================================================
# Use placeholders only. Never commit production secrets.

# ------------------------------------------------------------------------------
# Application Environment
# ------------------------------------------------------------------------------
APP_ENV=development # "development" | "test" | "production"
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# Database & Cache
# ------------------------------------------------------------------------------
DATABASE_URL="file:./dev.db" # Or postgresql://user:password@localhost:5432/heropage_saas
REDIS_URL="redis://localhost:6379"

# ------------------------------------------------------------------------------
# Cryptography & Security
# ------------------------------------------------------------------------------
# 32-byte hex string (64 hex characters) used for AES-256-GCM token encryption at rest
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
# Secret string for signing session JWT tokens
SESSION_SECRET=super-secret-session-key-change-me-in-production-min-32-chars

# ------------------------------------------------------------------------------
# Meta / Facebook Graph API Credentials (Official Meta App)
# ------------------------------------------------------------------------------
META_APP_ID=your_meta_app_id_here
META_APP_SECRET=your_meta_app_secret_here
META_VERIFY_TOKEN=your_custom_webhook_verify_token
META_GRAPH_API_VERSION=v19.0
META_PROVIDER_MODE=mock # "mock" for safe local testing | "real" for production Graph API

# ------------------------------------------------------------------------------
# Stripe Billing Integration
# ------------------------------------------------------------------------------
STRIPE_SECRET_KEY=sk_test_placeholder_key
STRIPE_WEBHOOK_SECRET=whsec_placeholder_secret
STRIPE_PRICE_STARTER=price_placeholder_starter
STRIPE_PRICE_PRO=price_placeholder_pro
STRIPE_PRICE_BUSINESS=price_placeholder_business
